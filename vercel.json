{
  "installCommand": "npm_config_cache=\"${npm_config_cache_dir:-$HOME/.npm}\" env -u npm_config_cache_dir npm install",
  "buildCommand": "npm_config_cache=\"${npm_config_cache_dir:-$HOME/.npm}\" env -u npm_config_cache_dir npm run build",
  "crons": [
    {
      "path": "/api/campaigns/process-queue",
      "schedule": "0 0 * * *"
    }
  ]
}
